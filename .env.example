TURSO_API_TOKEN=your-turso-api-token
TURSO_ORGANIZATION=your-organization-name
TURSO_DEFAULT_DATABASE=optional-default-database

# --- App (Sprint 1) ---
TURSO_DATABASE_URL=file:./data/app.db
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100

# --- App (Sprint 2) ---
# bunny.net Stream のライブラリID。シードがデモ用の再生URLを組み立てるのに使う。
# 実際の動画配信は後続スプリントで接続する。
BUNNY_LIBRARY_ID=301842

# --- App (Sprint 4) ---
# 動画再生URLの署名キー。bunny.net の Token Authentication で使う
# セキュリティキーをそのまま入れる想定（本番では必ず独自の値にする）。
# 未設定の場合は BETTER_AUTH_SECRET にフォールバックする。
BUNNY_STREAM_TOKEN_KEY=generate-with-openssl-rand-base64-32
# bunny.net Stream の Pull Zone ホスト名（例: vz-xxxxxxx-abc.b-cdn.net）。
# 設定されると src/lib/video-source.ts がローカルのダミー動画ではなく
# 署名付きの bunny.net CDN URL を返すようになる。未設定＝ローカル配信。
BUNNY_STREAM_HOSTNAME=

# --- App (Sprint 6) ---
# bunny.net Stream 管理API（動画の作成・ステータス取得）。ブラウザには露出しない。
BUNNY_STREAM_API_KEY=your-bunny-stream-access-key
# bunny.net Storage Zone（サムネイル保存先）。
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_KEY=your-storage-access-key
# Storage Zone のリージョン別APIホスト。Storage が東京(既定)以外のリージョンの場合は
# そちらのホストを指定する（例: https://sg.storage.bunnycdn.com）。
BUNNY_STORAGE_API_HOST=https://storage.bunnycdn.com
# Storage Zone の前段にある Pull Zone（サムネイル配信 CDN）のホスト名。
BUNNY_ASSETS_HOSTNAME=your-pull-zone.b-cdn.net
# Pull Zone の Token Authentication セキュリティキー。
BUNNY_CDN_TOKEN_KEY=your-pull-zone-token-key
